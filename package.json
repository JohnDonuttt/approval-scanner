{
  "name": "approval-scanner",
  "version": "0.1.0",
  "description": "List a wallet's ERC-20 token approvals, flag unlimited ones, and print revoke commands",
  "type": "module",
  "license": "MIT",
  "bin": { "approval-scanner": "dist/cli.js" },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "viem": "^2.38.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.0"
  }
}
